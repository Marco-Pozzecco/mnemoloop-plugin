{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2022",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"declaration": true,
		"outDir": "dist",
		"typeRoots": ["node_modules/@types"],
		"lib": ["DOM", "ES6"],
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"paths": {
			"@/*": ["./src/*"],
		},
	},
	"include": ["**/*.ts", "**/*.svelte"],
	"exclude": ["node_modules", "dist"],
}
