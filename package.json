{
	"name": "mnemoloop",
	"version": "1.10.0",
	"description": "An obsidian plugin for spaced repetition learning",
	"homepage": "https://github.com/Marco-Pozzecco/mnemoloop-plugin#readme",
	"bugs": {
		"url": "https://github.com/Marco-Pozzecco/mnemoloop-plugin/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/Marco-Pozzecco/mnemoloop-plugin.git"
	},
	"license": "MIT",
	"author": "Marco Pozzecco",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "vite build --watch --mode development",
		"build": "tsc -p tsconfig.build.json && vite build --mode production",
		"typecheck": "tsc --noEmit",
		"test": "vitest",
		"test:dom": "vitest --run --config vitest.dom.config.ts",
		"lint": "eslint --concurrency auto .",
		"lint:css-prefix": "python scripts/check-css-prefix.py",
		"format": "prettier --write src/**/*.{ts,tsx,svelte}",
		"generate-barrels": "python scripts/generate-barrels.py"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@types/d3-hierarchy": "^3.1.7",
		"@types/d3-scale": "^4.0.9",
		"@types/node": "^22",
		"@types/uuid": "^10.0.0",
		"@vitest/coverage-v8": "^1.6.1",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"eslint": "^10.4.1",
		"jsdom": "^24.1.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^16.5.0",
		"obsidian": "^1.4.0",
		"prettier": "^3.0.0",
		"sass": "^1.101.0",
		"semantic-release": "^25.0.5",
		"svelte-check": "^4.4.5",
		"svelte-eslint-parser": "^1.8.0",
		"svelte-preprocess": "^6.0.3",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.48.1",
		"vite": "^6.0.0",
		"vitest": "^1.0.0"
	},
	"dependencies": {
		"@dnd-kit/svelte": "^0.5.0",
		"@internationalized/date": "^3.12.1",
		"bits-ui": "^2.18.0",
		"d3-hierarchy": "^3.1.2",
		"d3-scale": "^4.0.2",
		"layerchart": "^2.0.0-next.56",
		"svelte": "^5.48.2",
		"ts-fsrs": "^5.2.3",
		"uuid": "^13.0.0",
		"zod": "^4.3.5"
	}
}
