{
  "name": "obs-knowledge-accelerator",
  "version": "1.0.0",
  "description": "An obsidian plugin for spaced repetition learning",
  "homepage": "https://github.com/Marco-Pozzecco/obs-knowledge-accelerator#readme",
  "bugs": {
    "url": "https://github.com/Marco-Pozzecco/obs-knowledge-accelerator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Marco-Pozzecco/obs-knowledge-accelerator.git"
  },
  "license": "ISC",
  "author": "Marco Pozzecco",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc && node esbuild.config.mjs --production && sh ./scripts/post-build.sh",
    "test": "vitest",
    "lint": "eslint src --ext .ts,.tsx && eslint .",
    "format": "prettier --write src/**/*.{ts,tsx,svelte}"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.19.0",
    "esbuild-svelte": "^0.8.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^16.5.0",
    "obsidian": "^1.4.0",
    "prettier": "^3.0.0",
    "svelte": "^5.0.0",
    "svelte-preprocess": "^6.0.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.48.1",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "svelte": "^5.48.2",
    "ts-fsrs": "^5.2.3",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  }
}
